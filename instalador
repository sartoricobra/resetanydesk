        if ($LASTEXITCODE -eq 0) { Write-Output "OK: Chipset AMD instalado/atualizado com sucesso." }
        else                     { Write-Output "AVISO: processo terminou com codigo $LASTEXITCODE." }
'@)

    # Trocado de winget para Chocolatey: o unico pacote AMD no winget e o
    # 'AMD.AMDSoftwareCloudEdition', que e a edicao para maquinas virtuais / cloud gaming e
    # esta parada na versao 23.Q3. Para desktop o correto e o Adrenalin Edition.
    $amdGpuScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- AMD Software: Adrenalin Edition (via Chocolatey) ---"
        $choco = Get-Choco
        if (-not $choco) { Write-Output "ERRO: Chocolatey nao encontrado."; return }
        & $choco install amd-software-adrenalin-edition -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
        if ($LASTEXITCODE -eq 0)        { Write-Output "OK: AMD Adrenalin instalado/atualizado com sucesso." }
        elseif ($LASTEXITCODE -eq 3010) { Write-Output "AVISO: instalado, reinicializacao pendente." }
        else                            { Write-Output "AVISO: processo terminou com codigo $LASTEXITCODE." }
'@)

    # Compara o que esta instalado na maquina com o que os repositorios oferecem.
    # Nao instala nada: so relata e sugere.
    #
    # De onde sai cada versao instalada:
    #   NVIDIA  - Win32_VideoController.DriverVersion, convertido para a versao comercial.
    #             O Windows reporta algo como 32.0.15.6094; os ultimos 5 digitos (56094)
    #             correspondem a versao 560.94 divulgada pela NVIDIA.
    #   Radeon  - DisplayVersion de "AMD Software" no registro de programas instalados.
    #             A chave HKLM\SOFTWARE\AMD\CN\RadeonSoftwareVersion existe mas costuma vir
    #             vazia, entao nao serve como fonte.
    #   Chipset - DisplayVersion de "AMD Chipset Software".
    $driverCheckScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Verificacao de drivers instalados ---"

        function Get-ProgramVersion([string]$padrao) {
            $chaves = @(
                'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
                'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
            )
            $item = Get-ItemProperty $chaves -ErrorAction SilentlyContinue |
                    Where-Object { $_.DisplayName -eq $padrao -and $_.DisplayVersion } |
                    Select-Object -First 1
            if ($item) { return $item.DisplayVersion }
            return $null
        }

        function Get-ChocoVersion([string]$pacote) {
            $choco = Get-Choco
            if (-not $choco) { return $null }
            $saida = & $choco search $pacote --exact --limit-output --source chocolatey 2>&1 | Out-String
            $m = [regex]::Match($saida, '(?im)^' + [regex]::Escape($pacote) + '\|(\S+)')
            if ($m.Success) { return $m.Groups[1].Value }
            return $null
        }

        function Compare-Versoes([string]$instalada, [string]$disponivel) {
            try {
                $a = [version]($instalada  -replace '[^\d\.]','')
                $b = [version]($disponivel -replace '[^\d\.]','')
                if ($b -gt $a) { return 'atualizar' }
                if ($b -eq $a) { return 'atual' }
                return 'mais nova que o repositorio'
            } catch { return 'indeterminado' }
        }

        $gpus = @(Get-CimInstance Win32_VideoController -ErrorAction SilentlyContinue)
        if ($gpus.Count -eq 0) { Write-Output "AVISO: nenhuma placa de video reportada pelo Windows." }
        foreach ($g in $gpus) {
            Write-Output ("Video detectado: {0}" -f $g.Name)
            Write-Output ("   driver do Windows: {0}   data: {1}" -f $g.DriverVersion, $(if ($g.DriverDate) { ([datetime]$g.DriverDate).ToString('dd/MM/yyyy') } else { 'n/d' }))
        }

        # ---------------- NVIDIA ----------------
        $nv = @($gpus | Where-Object { $_.Name -match 'NVIDIA' -or $_.AdapterCompatibility -match 'NVIDIA' })
        if ($nv.Count -eq 0) {
            Write-Output "NVIDIA: nenhuma GPU NVIDIA detectada, nada a verificar."
        } else {
            $digitos = ($nv[0].DriverVersion -replace '\D','')
            $atual = $null
            if ($digitos.Length -ge 5) {
                $u5 = $digitos.Substring($digitos.Length - 5)
                $atual = "{0}.{1}" -f $u5.Substring(0,3), $u5.Substring(3,2)
            }
            $novo = Get-ChocoVersion 'nvidia-display-driver'
            Write-Output ("NVIDIA: instalado {0} | repositorio {1}" -f $(if ($atual) { $atual } else { 'indeterminado' }), $(if ($novo) { $novo } else { 'indisponivel' }))
            if ($atual -and $novo) {
                switch (Compare-Versoes $atual $novo) {
                    'atualizar' { Write-Output "   SUGESTAO: ha driver mais novo. Use o botao 'Driver NVIDIA'." }
                    'atual'     { Write-Output "   OK: driver NVIDIA ja esta na versao do repositorio." }
                    default     { Write-Output "   OK: driver instalado e igual ou mais novo que o do repositorio." }
                }
            }
        }

        # ---------------- AMD Radeon ----------------
        $amd = @($gpus | Where-Object { $_.Name -match 'AMD|Radeon' -or $_.AdapterCompatibility -match 'Advanced Micro Devices' })
        if ($amd.Count -eq 0) {
            Write-Output "AMD Radeon: nenhuma GPU AMD detectada, nada a verificar."
        } else {
            $atual = Get-ProgramVersion 'AMD Software'
            $novo  = Get-ChocoVersion 'amd-software-adrenalin-edition'
            Write-Output ("AMD Radeon: instalado {0} | repositorio {1}" -f $(if ($atual) { $atual } else { 'AMD Software nao encontrado' }), $(if ($novo) { $novo } else { 'indisponivel' }))
            if ($atual -and $novo) {
                switch (Compare-Versoes $atual $novo) {
                    'atualizar' { Write-Output "   SUGESTAO: ha versao mais nova. Use o botao 'AMD Adrenalin'." }
                    'atual'     { Write-Output "   OK: AMD Adrenalin ja esta na versao do repositorio." }
                    default     { Write-Output "   OK: versao instalada e igual ou mais nova que a do repositorio." }
                }
            }
        }

        # ---------------- Chipset AMD ----------------
        $cpu = (Get-CimInstance Win32_Processor -ErrorAction SilentlyContinue | Select-Object -First 1).Name
        if ($cpu -notmatch 'AMD|Ryzen') {
            Write-Output ("Chipset AMD: processador '{0}' nao e AMD, nada a verificar." -f $cpu)
        } else {
            $atual = Get-ProgramVersion 'AMD Chipset Software'
            $novo  = Get-ChocoVersion 'amd-ryzen-chipset'
            Write-Output ("Chipset AMD ({0}):" -f $cpu.Trim())
            Write-Output ("   instalado: {0}" -f $(if ($atual) { $atual } else { 'AMD Chipset Software nao encontrado' }))
            Write-Output ("   repositorio: {0}" -f $(if ($novo) { $novo } else { 'indisponivel' }))
            # A versao do pacote choco e uma data (ex.: 2026.7.30) e a do driver e do tipo
            # 8.07.16.1035: numeracoes diferentes, entao comparar daria um veredito falso.
            Write-Output "   OBS: as duas numeracoes nao sao comparaveis entre si. Instale pelo botao"
            Write-Output "   'Chipset AMD' se quiser garantir a versao mais recente publicada."
        }

        Write-Output "OK: verificacao concluida. Nada foi instalado."
'@)

    $upgradeAllScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Atualizando todos os pacotes conhecidos pelo Winget ---"
        $winget = Get-Winget
        if (-not $winget) { Write-Output "ERRO: Winget nao encontrado nesta maquina."; return }
        & $winget upgrade --all --silent --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1 |
            ForEach-Object { Write-Output "  $_" }
        Write-Output "OK: rotina de atualizacao concluida."
'@)
    #endregion

    #region MOTOR DA FILA (timer)
    $taskTimer = New-Object Windows.Forms.Timer
    $taskTimer.Interval = 400

    $taskTimer.Add_Tick({

        # 1) Ha job rodando: drena a saida
        if ($null -ne $script:Job) {
            $output = Receive-Job -Job $script:Job *>&1
            foreach ($item in $output) {
                foreach ($line in ([string]$item -split "`r?`n")) {
                    $clean = $line.TrimEnd()
                    if (-not (Test-LogNoise $clean)) { Write-Log $clean }
                }
            }

            if ($script:Job.State -in @('Completed', 'Failed', 'Stopped')) {
                # drena o que sobrou antes de remover
                $rest = Receive-Job -Job $script:Job *>&1
                foreach ($item in $rest) {
                    foreach ($line in ([string]$item -split "`r?`n")) {
                        $clean = $line.TrimEnd()
                        if (-not (Test-LogNoise $clean)) { Write-Log $clean }
                    }
                }
                if ($script:Job.State -eq 'Failed') {
                    Write-Log ("ERRO: a tarefa '{0}' falhou." -f $script:JobName) 'error'
                }
                Remove-Job -Job $script:Job -Force -ErrorAction SilentlyContinue
                $script:Job = $null
                $script:DoneTasks++
                if ($script:DoneTasks -le $progressBar.Maximum) { $progressBar.Value = $script:DoneTasks }
                Update-PathFromRegistry
            }
            return
        }

        # 2) Cancelamento pedido
        if ($script:Cancelling) {
            Stop-Queue 'Execucao cancelada pelo usuario.'
            return
        }

        # 3) Proxima tarefa da fila
        if ($script:Queue.Count -gt 0) {
            $task = $script:Queue.Dequeue()
            $script:JobName   = $task.Name
            $statusLabel.Text = ('Executando: {0}   ({1}/{2})' -f $task.Name, ($script:DoneTasks + 1), $script:TotalTasks)
            Write-Log ('>>> {0}' -f $task.Name) 'head'
            try {
                if ($task.Arguments -and $task.Arguments.Count -gt 0) {
                    $script:Job = Start-Job -ScriptBlock $task.Script -ArgumentList $task.Arguments
                } else {
                    $script:Job = Start-Job -ScriptBlock $task.Script
                }
            } catch {
                Write-Log ("ERRO: nao foi possivel iniciar a tarefa '{0}'. {1}" -f $task.Name, $_.Exception.Message) 'error'
                $script:DoneTasks++
            }
            return
        }

        # 4) Fila vazia
        Stop-Queue
    })
    #endregion

    #region EVENTOS

    # --- filtro de busca ---
    $searchBox.Add_TextChanged({
        $q = $searchBox.Text.Trim()
        $searchHint.Visible = [string]::IsNullOrEmpty($q)

        foreach ($cat in $script:CatList) {
            $catMatch = $cat.Name -like "*$q*"
            foreach ($chip in $cat.Chips) {
                $match = [string]::IsNullOrEmpty($q) -or $catMatch -or
                         ($chip.Text -like "*$q*") -or ($chip.Tag.ID -like "*$q*")
                $chip.Tag.Show = $match
                $chip.Visible  = $match
            }
        }
        Update-AppLayout
    })
    $searchHint.Add_Click({ $searchBox.Focus() })

    $appsPanel.Add_ClientSizeChanged({
        if ($appsPanel.ClientSize.Width -ne $script:LastWidth) {
            $script:LastWidth = $appsPanel.ClientSize.Width
            Update-AppLayout
        }
    })

    # --- selecao ---
    $selectDefaultButton.Add_Click({
        foreach ($chip in $script:AllChips) { if ($chip.Tag.Def) { $chip.Checked = $true } }
    })
    # "Todos" e "Inverter" agem apenas sobre o que o filtro esta exibindo; "Nenhum" limpa tudo.
    $selectAllButton.Add_Click({
        foreach ($chip in $script:AllChips) { if ($chip.Tag.Show) { $chip.Checked = $true } }
    })
    $deselectAllButton.Add_Click({
        foreach ($chip in $script:AllChips) { $chip.Checked = $false }
    })
    $invertButton.Add_Click({
        foreach ($chip in $script:AllChips) { if ($chip.Tag.Show) { $chip.Checked = -not $chip.Checked } }
    })

    # --- log ---
    $copyLogButton.Add_Click({
        if ($logBox.TextLength -gt 0) {
            [Windows.Forms.Clipboard]::SetText($logBox.Text)
            $statusLabel.Text = 'Log copiado para a area de transferencia.'
        }
    })
    $saveLogButton.Add_Click({
        $dlg = New-Object Windows.Forms.SaveFileDialog
        $dlg.Filter   = 'Arquivo de texto (*.txt)|*.txt'
        $dlg.FileName = 'posinstalador-log-{0}.txt' -f (Get-Date -Format 'yyyyMMdd-HHmm')
        $dlg.InitialDirectory = [Environment]::GetFolderPath('Desktop')
        if ($dlg.ShowDialog() -eq 'OK') {
            [IO.File]::WriteAllText($dlg.FileName, $logBox.Text, (New-Object Text.UTF8Encoding($true)))
            $statusLabel.Text = "Log salvo em $($dlg.FileName)"
        }
    })
    $clearLogButton.Add_Click({ $logBox.Clear() })

    # --- instalacao ---
    $installButton.Add_Click({
        $selected = @($script:AllChips | Where-Object { $_.Checked } | ForEach-Object { $_.Tag })
        if ($selected.Count -eq 0) {
            [Windows.Forms.MessageBox]::Show('Nenhum aplicativo selecionado.', 'Aviso', 'OK', 'Warning') | Out-Null
            return
        }

        $resp = [Windows.Forms.MessageBox]::Show(
            ("Instalar {0} aplicativo(s) agora?" -f $selected.Count),
            'Confirmar instalacao', 'YesNo', 'Question')
        if ($resp -ne 'Yes') { return }

        $needChoco  = [bool](@($selected | Where-Object { $_.Src -eq 'choco' }).Count)
        $needWinget = [bool](@($selected | Where-Object { $_.Src -ne 'choco' }).Count)

        if ($needChoco  -and -not (Test-Tool 'choco'))  { Add-Task 'Preparando o Chocolatey' $chocoBootstrapScript }
        if ($needWinget -and -not (Test-Tool 'winget')) {
            if (-not (Test-Tool 'choco')) { Add-Task 'Preparando o Chocolatey' $chocoBootstrapScript }
            Add-Task 'Preparando o Winget' $wingetBootstrapScript
        }

        foreach ($app in $selected) {
            Add-Task ("Instalando {0}" -f $app.Nome) $installAppScript @($app)
        }
        Start-Queue
    })

    $cancelButton.Add_Click({
        $script:Cancelling = $true
        $script:Queue.Clear()
        if ($null -ne $script:Job) {
            Write-Log 'Cancelando... (processos de instalacao ja iniciados podem continuar em segundo plano)' 'warn'
            Stop-Job -Job $script:Job -ErrorAction SilentlyContinue
        }
    })

    # --- drivers e ferramentas ---
    $startSingle = {
        param([string]$Name, [scriptblock]$Script, [bool]$RequiresChoco, [bool]$RequiresWinget)
        if ($RequiresChoco  -and -not (Test-Tool 'choco'))  { Add-Task 'Preparando o Chocolatey' $chocoBootstrapScript }
        if ($RequiresWinget -and -not (Test-Tool 'winget')) {
            if (-not (Test-Tool 'choco')) { Add-Task 'Preparando o Chocolatey' $chocoBootstrapScript }
            Add-Task 'Preparando o Winget' $wingetBootstrapScript
        }
        Add-Task $Name $Script
        Start-Queue
    }

    $checkDriversButton.Add_Click({ & $startSingle 'Verificando drivers' $driverCheckScript $true $false })
    $nvidiaButton.Add_Click({     & $startSingle 'Driver NVIDIA'    $nvidiaScript     $true  $false })
    $nvidiaAppButton.Add_Click({  & $startSingle 'NVIDIA App'       $nvidiaAppScript  $true  $false })
    $amdChipsetButton.Add_Click({ & $startSingle 'Chipset AMD'      $amdChipsetScript $true  $false })
    $amdGpuButton.Add_Click({     & $startSingle 'AMD Adrenalin'    $amdGpuScript     $true  $false })
    $upgradeButton.Add_Click({
        $resp = [Windows.Forms.MessageBox]::Show(
            "Atualizar todos os programas conhecidos pelo Winget?`n`nIsso pode demorar bastante.",
            'Confirmar', 'YesNo', 'Question')
        if ($resp -eq 'Yes') { & $startSingle 'Atualizar todos os apps' $upgradeAllScript $false $true }
    })

    $activatorButton.Add_Click({
        $msg = "AVISO DE SEGURANCA`n`n" +
               "Voce esta prestes a executar um script baixado de get.activated.win.`n" +
               "Ele abrira em uma janela de console propria, pois possui menu interativo.`n`n" +
               "Executar scripts de fontes nao confiaveis pode ser perigoso. Deseja continuar?"
        $resp = [Windows.Forms.MessageBox]::Show($msg, 'Confirmacao de seguranca', 'YesNo', 'Warning')
        if ($resp -ne 'Yes') { Write-Log 'Ativador cancelado pelo usuario.' 'warn'; return }

        try {
            Start-Process -FilePath 'powershell.exe' -ArgumentList @(
                '-NoProfile', '-ExecutionPolicy', 'Bypass',
                '-Command', 'irm https://get.activated.win | iex'
            )
            Write-Log 'Ativador iniciado em uma janela separada. Continue por la.' 'ok'
        } catch {
            Write-Log ("ERRO: nao foi possivel iniciar o ativador. {0}" -f $_.Exception.Message) 'error'
        }
    })

    # --- ciclo de vida da janela ---
    $mainForm.Add_Shown({
        # Ajusta a janela a area util da tela (apos o scaling por DPI ja ter sido aplicado).
        $wa = [Windows.Forms.Screen]::FromControl($mainForm).WorkingArea
        $w  = [Math]::Min($mainForm.Width,  [int]($wa.Width  * 0.94))
        $h  = [Math]::Min($mainForm.Height, [int]($wa.Height * 0.94))
        $w  = [Math]::Max($w, $mainForm.MinimumSize.Width)
        $h  = [Math]::Max($h, $mainForm.MinimumSize.Height)
        $mainForm.Size     = New-Object Drawing.Size($w, $h)
        $mainForm.Location = New-Object Drawing.Point(
            ($wa.X + [int](($wa.Width  - $w) / 2)),
            ($wa.Y + [int](($wa.Height - $h) / 2)))

        Update-AppLayout
        Update-SelectionCount

        # A divisoria e dimensionada pelo conteudo: a selecao recebe apenas a altura que precisa
        # e o log fica com todo o resto (limitado a 62% para nao engolir o log em telas baixas).
        try {
            # altura exata: conteudo + barra de ferramentas + padding do painel + folga minima
            $needed = $script:ContentHeight + $toolbar.Height + $split.Panel1.Padding.Vertical + (Px 6)
            $min    = $split.Panel1MinSize
            $max    = $split.Height - $split.Panel2MinSize - $split.SplitterWidth
            $cap    = [int]($split.Height * 0.62)
            $target = [Math]::Min($needed, $cap)
            if ($max -gt $min) {
                $split.SplitterDistance = [Math]::Max($min, [Math]::Min($target, $max))
            }
        } catch { }

        Update-AppLayout

        Write-Log "$AppTitle v$AppVersion pronto." 'ok'
        Write-Log ('Ambiente: Winget {0} | Chocolatey {1}' -f
            $(if (Test-Tool 'winget') { 'OK' } else { 'ausente (sera instalado se necessario)' }),
            $(if (Test-Tool 'choco')  { 'OK' } else { 'ausente (sera instalado se necessario)' }))
        Write-Log 'Selecione os programas e clique em INSTALAR SELECIONADOS. Arraste a divisoria para ampliar o log.'
    })

    $mainForm.Add_FormClosing({
        if ($null -ne $script:Job -or $script:Queue.Count -gt 0) {
            $r = [Windows.Forms.MessageBox]::Show(
                'Ha tarefas em andamento. Deseja realmente fechar?', 'Confirmar', 'YesNo', 'Warning')
            if ($r -ne 'Yes') { $_.Cancel = $true; return }
        }
        $taskTimer.Stop()
        if ($null -ne $script:Job) {
            Stop-Job   -Job $script:Job -ErrorAction SilentlyContinue
            Remove-Job -Job $script:Job -Force -ErrorAction SilentlyContinue
        }
    })
    #endregion

    #region EXECUCAO
    [void]$mainForm.ShowDialog()
    #endregion
}
catch {
    $err = "Erro inesperado:`n`n$($_.Exception.Message)`n`nEm: $($_.InvocationInfo.PositionMessage)"
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        [Windows.Forms.MessageBox]::Show($err, 'Pos Instalador - erro', 'OK', 'Error') | Out-Null
    } catch {
        Write-Warning $err
    }
}
finally {
    # Remove a copia temporaria criada durante a auto-elevacao
    if ($PSCommandPath -and $PSCommandPath.StartsWith($env:TEMP, [StringComparison]::OrdinalIgnoreCase)) {
        Remove-Item $PSCommandPath -Force -ErrorAction SilentlyContinue
    }
}
