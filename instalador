    # Fator de escala da tela (1.0 = 96 dpi, 1.25 = 125%, 1.5 = 150%...).
    # As fontes sao declaradas em pontos, entao o Windows ja as desenha maiores em telas
    # escaladas; quem NAO cresce sozinho e todo tamanho fixo em pixel. Por isso cada medida
    # em pixel deste script passa por Px(). O auto-scaling do WinForms fica desligado
    # (AutoScaleMode = None) para nao aplicar um segundo fator por baixo dos panos.
    $script:DpiScale = 1.0
    try {
        $gfx = [Drawing.Graphics]::FromHwnd([IntPtr]::Zero)
        if ($gfx.DpiX -gt 0) { $script:DpiScale = $gfx.DpiX / 96.0 }
        $gfx.Dispose()
    } catch { }

    function Px {
        param([double]$Pixels)
        return [int][Math]::Round($Pixels * $script:DpiScale)
    }

    # Largura que um texto realmente ocupa, medida na fonte real e no DPI real.
    function Get-TextWidth {
        param([string]$Text, [Drawing.Font]$Font)
        return [Windows.Forms.TextRenderer]::MeasureText($Text, $Font).Width
    }

    # --- Cantos arredondados -------------------------------------------------------------
    # O WinForms nao tem propriedade de raio de canto. O caminho e recortar o controle com
    # uma Region em forma de retangulo arredondado; os cantos passam a mostrar o fundo do
    # painel atras. Funciona com o desenho nativo do botao, entao hover, clique e estado
    # desabilitado continuam se comportando normalmente.
    function Set-ControlRegion {
        param([Windows.Forms.Control]$Control, [int]$Radius)

        if ($Control.Width -le 0 -or $Control.Height -le 0) { return }

        $d = [Math]::Max(2, $Radius * 2)
        if ($d -gt $Control.Height) { $d = $Control.Height }
        if ($d -gt $Control.Width)  { $d = $Control.Width  }

        $w = $Control.Width
        $h = $Control.Height

        $path = New-Object Drawing.Drawing2D.GraphicsPath
        $path.AddArc(0, 0, $d, $d, 180, 90)
        $path.AddArc(($w - $d), 0, $d, $d, 270, 90)
        $path.AddArc(($w - $d), ($h - $d), $d, $d, 0, 90)
        $path.AddArc(0, ($h - $d), $d, $d, 90, 90)
        $path.CloseFigure()

        # Descarta a Region anterior: os botoes em Dock='Fill' sao redimensionados a cada
        # mudanca de tamanho da janela, e sem isso vazariam handles do GDI.
        $anterior = $Control.Region
        $Control.Region = New-Object Drawing.Region($path)
        if ($anterior) { $anterior.Dispose() }
        $path.Dispose()
    }

    function Set-Rounded {
        param([Windows.Forms.Control]$Control, [int]$Radius = 0)

        if ($Radius -le 0) { $Radius = Px 6 }
        $raio = $Radius

        # GetNewClosure() fixa o valor de $raio no scriptblock. Sem isso, o handler leria a
        # variavel so na hora do evento, quando ela ja teria outro valor (ou nenhum).
        $Control.Add_Resize({ Set-ControlRegion $this $raio }.GetNewClosure())
        Set-ControlRegion $Control $raio
    }
