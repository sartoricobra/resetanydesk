    #region FUNCOES DE APOIO

    function Update-SelectionCount {
        $n = @($script:AllChips | Where-Object { $_.Checked }).Count
        $countLabel.Text = if ($n -eq 1) { '1 selecionado' } else { "$n selecionados" }
    }

    function Update-AppLayout {
        if ($script:LayoutBusy) { return }
        if ($script:CatList.Count -eq 0) { return }

        $avail = $appsPanel.ClientSize.Width - 2
        if ($avail -lt 150) { return }

        $script:LayoutBusy = $true
        try {
            $appsPanel.SuspendLayout()

            $gap  = 8
            $cols = [Math]::Floor($avail / 330)
            if ($cols -lt 1) { $cols = 1 }
            if ($cols -gt 4) { $cols = 4 }

            $colW  = [Math]::Floor(($avail - ($gap * ($cols - 1))) / $cols)
            $flowW = $colW - 14

            $colY = New-Object 'int[]' $cols

            foreach ($cat in $script:CatList) {
                $visible = @($cat.Chips | Where-Object { $_.Tag.Show })
                if ($visible.Count -eq 0) {
                    $cat.Group.Visible = $false
                    continue
                }
                $cat.Group.Visible = $true

                # Deixa o proprio FlowLayoutPanel calcular quantas linhas os chips ocupam
                # nesta largura, em vez de estimar por divisao.
                $cat.Flow.Width = $flowW
                $flowH  = $cat.Flow.GetPreferredSize((New-Object Drawing.Size($flowW, 0))).Height
                if ($flowH -lt 25) { $flowH = 25 }
                $groupH = $flowH + 26

                # coluna mais curta (empacotamento tipo masonry)
                $idx = 0
                for ($i = 1; $i -lt $cols; $i++) {
                    if ($colY[$i] -lt $colY[$idx]) { $idx = $i }
                }

                $cat.Group.Location = New-Object Drawing.Point(($idx * ($colW + $gap)), $colY[$idx])
                $cat.Group.Size     = New-Object Drawing.Size($colW, $groupH)
                $cat.Flow.Location  = New-Object Drawing.Point(8, 17)
                $cat.Flow.Size      = New-Object Drawing.Size($flowW, $flowH)

                $colY[$idx] = $colY[$idx] + $groupH + $gap
            }

            # altura real ocupada pelas categorias: usada para dimensionar o divisor
            $tallest = 0
            foreach ($y in $colY) { if ($y -gt $tallest) { $tallest = $y } }
            $script:ContentHeight = [Math]::Max(0, $tallest - $gap)
        }
        finally {
            $appsPanel.ResumeLayout()
            $script:LayoutBusy = $false
        }
    }

    # Blocos de barra de progresso do winget. Montado em runtime para manter o arquivo em ASCII puro
    # (o script e baixado e avaliado por "irm | iex", onde qualquer byte acentuado vira lixo).
    $noiseChars = -join @(0x2588, 0x2592, 0x2591, 0x25CF, 0x00B7 | ForEach-Object { [char]$_ })
    $noiseRegex = '^[\s\-\\|/\.' + [regex]::Escape($noiseChars) + ']+$'

    function Test-LogNoise {
        param([string]$Line)
        if ([string]::IsNullOrWhiteSpace($Line))                  { return $true }
        # barras de progresso do choco/winget inundam o log
        if ($Line -match 'Progress:' -and $Line -notmatch '100%') { return $true }
        if ($Line -match $noiseRegex)                             { return $true }
        if ($Line -match '^\s*\d{1,3}%\s*$')                      { return $true }
        return $false
    }

    function Write-Log {
        param([string]$Text, [string]$Level = 'auto')

        if ($null -eq $Text) { return }

        if ($Level -eq 'auto') {
            if     ($Text -match '^\s*={3,}|^\s*-{3,}')                     { $Level = 'head'  }
            elseif ($Text -match 'ERRO|ERROR|Falha|failed|nao encontrado')  { $Level = 'error' }
            elseif ($Text -match 'AVISO|WARN|cancelad')                     { $Level = 'warn'  }
            elseif ($Text -match 'sucesso|success|concluid|Ja instalado')   { $Level = 'ok'    }
            else                                                            { $Level = 'info'  }
        }

        $color = switch ($Level) {
            'head'  { $Theme.LogCyan }
            'error' { $Theme.LogRed }
            'warn'  { $Theme.LogAmber }
            'ok'    { $Theme.LogGreen }
            default { $Theme.LogFg }
        }

        # evita degradacao de performance em instalacoes muito longas
        if ($logBox.TextLength -gt 400000) {
            $logBox.Clear()
            $logBox.SelectionColor = $Theme.LogDim
            $logBox.AppendText("[log truncado para manter o desempenho]`n")
        }

        $logBox.SelectionStart  = $logBox.TextLength
        $logBox.SelectionLength = 0
        $logBox.SelectionColor  = $Theme.LogDim
        $logBox.AppendText(('[{0}] ' -f (Get-Date -Format 'HH:mm:ss')))
        $logBox.SelectionColor  = $color
        $logBox.AppendText("$Text`n")
        $logBox.SelectionColor  = $Theme.LogFg

        if ($autoScrollCheck.Checked) {
            $logBox.SelectionStart = $logBox.TextLength
            $logBox.ScrollToCaret()
        }
    }

    function Set-UiBusy {
        param([bool]$Busy)
        $appsPanel.Enabled    = -not $Busy
        $toolbar.Enabled      = -not $Busy
        $toolsBox.Enabled     = -not $Busy
        $installButton.Enabled= -not $Busy
        $cancelButton.Enabled = $Busy
        $mainForm.Cursor      = if ($Busy) { 'AppStarting' } else { 'Default' }
    }

    function Test-Tool {
        param([string]$Name)
        return [bool](Get-Command $Name -ErrorAction SilentlyContinue)
    }

    function Update-PathFromRegistry {
        try {
            $machine = [Environment]::GetEnvironmentVariable('Path', 'Machine')
            $user    = [Environment]::GetEnvironmentVariable('Path', 'User')
            $env:Path = (@($machine, $user) | Where-Object { $_ }) -join ';'
        } catch { }
    }

    function Add-Task {
        param([string]$Name, [scriptblock]$Script, $Arguments = @())
        $script:Queue.Enqueue([pscustomobject]@{ Name = $Name; Script = $Script; Arguments = @($Arguments) })
    }

    function Start-Queue {
        if ($script:Queue.Count -eq 0) { return }
        $script:TotalTasks = $script:Queue.Count
        $script:DoneTasks  = 0
        $script:Cancelling = $false
        $progressBar.Maximum = $script:TotalTasks
        $progressBar.Value   = 0
        Set-UiBusy $true
        Write-Log ('=== Iniciando {0} tarefa(s) ===' -f $script:TotalTasks) 'head'
        $taskTimer.Start()
    }

    function Stop-Queue {
        param([string]$Reason = 'Todas as tarefas foram concluidas.')
        $taskTimer.Stop()
        $script:Queue.Clear()
        $script:Job = $null
        $progressBar.Value = $progressBar.Maximum
        Set-UiBusy $false
        $statusLabel.Text = $Reason
        Write-Log "=== $Reason ===" 'head'
    }
    #endregion

    #region BLOCOS DE TAREFA (executam em background job)

    # Preambulo replicado dentro de cada job: resolve executaveis mesmo sem PATH atualizado.
    $jobPreamble = @'
        $ErrorActionPreference = 'Continue'
        try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }

        function Resolve-Exe([string]$name, [string[]]$fallbacks) {
            $cmd = Get-Command $name -ErrorAction SilentlyContinue
            if ($cmd) { return $cmd.Source }
            foreach ($f in $fallbacks) { if ($f -and (Test-Path $f)) { return $f } }
            return $null
        }
        function Get-Choco  { Resolve-Exe 'choco'  @("$env:ProgramData\chocolatey\bin\choco.exe") }
        function Get-Winget { Resolve-Exe 'winget' @() }

        function Show-WingetResult([int]$code, [string]$nome) {
            switch ($code) {
                0            { "OK: $nome instalado com sucesso." }
                -1978335189  { "OK: $nome ja instalado / nada a fazer." }
                -1978335212  { "ERRO: pacote de $nome nao encontrado no repositorio." }
                -1978335216  { "ERRO: $nome - contrato de origem nao aceito." }
                -1978334956  { "AVISO: $nome exige reinicializacao para concluir." }
                default      { "AVISO: $nome terminou com codigo $code." }
            }
        }
'@

    # ATENCAO: o bloco param() precisa ser a PRIMEIRA instrucao do scriptblock. Se vier depois do
    # preambulo, o PowerShell o interpreta como uma chamada de comando, o argumento nao e vinculado
    # e $app chega nulo dentro do job.
    $installAppScript = [scriptblock]::Create("param(`$app)`n" + $jobPreamble + @'

        Write-Output ("--- {0}  [{1}: {2}] ---" -f $app.Nome, $app.Src, $app.ID)

        if ($app.Src -eq 'choco') {
            $choco = Get-Choco
            if (-not $choco) { Write-Output "ERRO: Chocolatey nao encontrado."; return }
            & $choco install $app.ID -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
            if ($LASTEXITCODE -eq 0)      { Write-Output "OK: $($app.Nome) instalado com sucesso via Chocolatey." }
            elseif ($LASTEXITCODE -eq 3010) { Write-Output "AVISO: $($app.Nome) instalado, reinicializacao pendente." }
            else                          { Write-Output "AVISO: $($app.Nome) terminou com codigo $LASTEXITCODE." }
            return
        }

        $winget = Get-Winget
        if (-not $winget) { Write-Output "ERRO: Winget nao encontrado nesta maquina."; return }

        $wingetArgs = @(
            'install', '--id', $app.ID, '--exact', '--silent',
            '--accept-package-agreements', '--accept-source-agreements', '--disable-interactivity'
        )
        if ($app.Src -eq 'msstore') { $wingetArgs += @('--source', 'msstore') }
        else                        { $wingetArgs += @('--source', 'winget')  }

        Write-Output ("COMANDO: winget {0}" -f ($wingetArgs -join ' '))
        & $winget @wingetArgs 2>&1 | ForEach-Object { Write-Output "  $_" }
        Write-Output (Show-WingetResult $LASTEXITCODE $app.Nome)
'@)

    $chocoBootstrapScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Instalando o Chocolatey ---"
        if (Get-Choco) { Write-Output "OK: Chocolatey ja esta instalado."; return }
        try {
            Set-ExecutionPolicy Bypass -Scope Process -Force
            [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor 3072
            Invoke-Expression ((New-Object Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')) 2>&1 |
                ForEach-Object { Write-Output "  $_" }
        } catch {
            Write-Output "ERRO: Falha ao instalar o Chocolatey. $($_.Exception.Message)"
            return
        }
        if (Get-Choco) { Write-Output "OK: Chocolatey instalado com sucesso." }
        else           { Write-Output "ERRO: A instalacao do Chocolatey nao pode ser confirmada." }
'@)

    $wingetBootstrapScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Instalando o Winget (via Chocolatey) ---"
        if (Get-Winget) { Write-Output "OK: Winget ja esta instalado."; return }
        $choco = Get-Choco
        if (-not $choco) { Write-Output "ERRO: Chocolatey indisponivel, nao e possivel instalar o Winget."; return }
        & $choco install microsoft-winget -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
        if ($LASTEXITCODE -eq 0) { Write-Output "OK: Winget instalado com sucesso." }
        else                     { Write-Output "AVISO: instalacao do Winget terminou com codigo $LASTEXITCODE." }
'@)

    $nvidiaScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Driver NVIDIA (via Chocolatey) ---"
        $choco = Get-Choco
        if (-not $choco) { Write-Output "ERRO: Chocolatey nao encontrado."; return }
        & $choco install nvidia-display-driver -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
        if ($LASTEXITCODE -eq 0) { Write-Output "OK: Driver NVIDIA instalado/atualizado com sucesso." }
        else                     { Write-Output "AVISO: processo terminou com codigo $LASTEXITCODE." }
'@)

    $amdChipsetScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Chipset AMD (via Chocolatey) ---"
        $choco = Get-Choco
        if (-not $choco) { Write-Output "ERRO: Chocolatey nao encontrado."; return }
        & $choco install amd-ryzen-chipset -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
        if ($LASTEXITCODE -eq 0) { Write-Output "OK: Chipset AMD instalado/atualizado com sucesso." }
        else                     { Write-Output "AVISO: processo terminou com codigo $LASTEXITCODE." }
'@)

    $amdGpuScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Software AMD GPU (via Winget) ---"
        $winget = Get-Winget
        if (-not $winget) { Write-Output "ERRO: Winget nao encontrado nesta maquina."; return }
        $id = 'AMD.AMDSoftwareCloudEdition'
        $wingetArgs = @('install','--id',$id,'--exact','--silent','--source','winget',
                        '--accept-package-agreements','--accept-source-agreements','--disable-interactivity')
        & $winget @wingetArgs 2>&1 | ForEach-Object { Write-Output "  $_" }
        Write-Output (Show-WingetResult $LASTEXITCODE 'Software AMD GPU')
'@)

    $upgradeAllScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Atualizando todos os pacotes conhecidos pelo Winget ---"
        $winget = Get-Winget
        if (-not $winget) { Write-Output "ERRO: Winget nao encontrado nesta maquina."; return }
        & $winget upgrade --all --silent --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1 |
            ForEach-Object { Write-Output "  $_" }
        Write-Output "OK: rotina de atualizacao concluida."
'@)
    #endregion

    #region MOTOR DA FILA (timer)
    $taskTimer = New-Object Windows.Forms.Timer
    $taskTimer.Interval = 400

    $taskTimer.Add_Tick({

        # 1) Ha job rodando: drena a saida
        if ($null -ne $script:Job) {
            $output = Receive-Job -Job $script:Job *>&1
            foreach ($item in $output) {
                foreach ($line in ([string]$item -split "`r?`n")) {
                    $clean = $line.TrimEnd()
                    if (-not (Test-LogNoise $clean)) { Write-Log $clean }
                }
            }

            if ($script:Job.State -in @('Completed', 'Failed', 'Stopped')) {
                # drena o que sobrou antes de remover
                $rest = Receive-Job -Job $script:Job *>&1
                foreach ($item in $rest) {
                    foreach ($line in ([string]$item -split "`r?`n")) {
                        $clean = $line.TrimEnd()
                        if (-not (Test-LogNoise $clean)) { Write-Log $clean }
                    }
                }
                if ($script:Job.State -eq 'Failed') {
                    Write-Log ("ERRO: a tarefa '{0}' falhou." -f $script:JobName) 'error'
                }
                Remove-Job -Job $script:Job -Force -ErrorAction SilentlyContinue
                $script:Job = $null
                $script:DoneTasks++
                if ($script:DoneTasks -le $progressBar.Maximum) { $progressBar.Value = $script:DoneTasks }
                Update-PathFromRegistry
            }
            return
        }

        # 2) Cancelamento pedido
        if ($script:Cancelling) {
            Stop-Queue 'Execucao cancelada pelo usuario.'
            return
        }

        # 3) Proxima tarefa da fila
        if ($script:Queue.Count -gt 0) {
            $task = $script:Queue.Dequeue()
            $script:JobName   = $task.Name
            $statusLabel.Text = ('Executando: {0}   ({1}/{2})' -f $task.Name, ($script:DoneTasks + 1), $script:TotalTasks)
            Write-Log ('>>> {0}' -f $task.Name) 'head'
            try {
                if ($task.Arguments -and $task.Arguments.Count -gt 0) {
                    $script:Job = Start-Job -ScriptBlock $task.Script -ArgumentList $task.Arguments
                } else {
                    $script:Job = Start-Job -ScriptBlock $task.Script
                }
            } catch {
                Write-Log ("ERRO: nao foi possivel iniciar a tarefa '{0}'. {1}" -f $task.Name, $_.Exception.Message) 'error'
                $script:DoneTasks++
            }
            return
        }

        # 4) Fila vazia
        Stop-Queue
    })
    #endregion

    #region EVENTOS

    # --- filtro de busca ---
    $searchBox.Add_TextChanged({
        $q = $searchBox.Text.Trim()
        $searchHint.Visible = [string]::IsNullOrEmpty($q)

        foreach ($cat in $script:CatList) {
            $catMatch = $cat.Name -like "*$q*"
            foreach ($chip in $cat.Chips) {
                $match = [string]::IsNullOrEmpty($q) -or $catMatch -or
                         ($chip.Text -like "*$q*") -or ($chip.Tag.ID -like "*$q*")
                $chip.Tag.Show = $match
                $chip.Visible  = $match
            }
        }
        Update-AppLayout
    })
    $searchHint.Add_Click({ $searchBox.Focus() })

    $appsPanel.Add_ClientSizeChanged({
        if ($appsPanel.ClientSize.Width -ne $script:LastWidth) {
            $script:LastWidth = $appsPanel.ClientSize.Width
            Update-AppLayout
        }
    })

    # --- selecao ---
    $selectDefaultButton.Add_Click({
        foreach ($chip in $script:AllChips) { if ($chip.Tag.Def) { $chip.Checked = $true } }
    })
    # "Todos" e "Inverter" agem apenas sobre o que o filtro esta exibindo; "Nenhum" limpa tudo.
    $selectAllButton.Add_Click({
        foreach ($chip in $script:AllChips) { if ($chip.Tag.Show) { $chip.Checked = $true } }
    })
    $deselectAllButton.Add_Click({
