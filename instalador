#region ELEVACAO
# Forca TLS 1.2 (necessario em instalacoes antigas do Windows para baixar de HTTPS)
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$currentUser = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $currentUser.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {

    $baseArgs = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden')

    if ($PSCommandPath) {
        # Executando a partir de um arquivo .ps1 local
        $relaunchArgs = $baseArgs + @('-File', ('"{0}"' -f $PSCommandPath))
    }
    elseif (-not [string]::IsNullOrWhiteSpace($ScriptUrl)) {
        # Executando via "irm <url> | iex" e a URL foi informada: repete o download ja elevado
        $relaunchArgs = $baseArgs + @('-Command', ("irm '{0}' | iex" -f $ScriptUrl))
    }
    else {
        # Executando via "irm | iex" sem URL configurada: grava o proprio codigo em arquivo temporario
        $code = $null
        try { $code = $MyInvocation.MyCommand.ScriptBlock.ToString() } catch { }
        if ([string]::IsNullOrWhiteSpace($code)) { $code = $MyInvocation.MyCommand.Definition }

        if ([string]::IsNullOrWhiteSpace($code)) {
            Write-Warning 'Nao foi possivel obter o codigo do script para elevar. Abra o PowerShell como Administrador e execute novamente.'
            return
        }

        $tempScriptPath = Join-Path $env:TEMP ('posinstalador_{0}.ps1' -f ([Guid]::NewGuid().ToString('N')))
        [IO.File]::WriteAllText($tempScriptPath, $code, (New-Object Text.UTF8Encoding($true)))
        $relaunchArgs = $baseArgs + @('-File', ('"{0}"' -f $tempScriptPath))
    }

    Write-Warning 'Permissao de administrador necessaria. Reabrindo com elevacao...'
    try {
        Start-Process -FilePath 'powershell.exe' -ArgumentList $relaunchArgs -Verb RunAs -ErrorAction Stop
    } catch {
        Write-Warning "Elevacao cancelada ou bloqueada. O script nao pode continuar sem privilegios de administrador."
    }
    return
}
#endregion

