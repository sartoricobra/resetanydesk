            $chip = New-Object Windows.Forms.CheckBox
            $chip.Appearance = [Windows.Forms.Appearance]::Button
            $chip.Text       = $app.Nome
            # 'Show' guarda o estado do filtro de busca. Nao usamos a propriedade Visible como fonte
            # da verdade porque o getter dela retorna false enquanto o formulario nao esta visivel,
            # e o layout roda tambem em ClientSizeChanged, antes do evento Shown.
            $chip.Tag        = [pscustomobject]@{ Nome = $app.Nome; ID = $app.ID; Src = $src; Def = [bool]$app.Def; Show = $true }
            $chip.TextAlign  = 'MiddleCenter'
            $chip.FlatStyle  = 'Flat'
            $chip.Font       = $FontChip
            $chip.Margin     = New-Object Windows.Forms.Padding(0, 0, 4, 4)
            $chip.BackColor  = $Theme.ChipBg
            $chip.Cursor     = 'Hand'
            # Cada chip se dimensiona pelo proprio rotulo: "VLC" ocupa muito menos que
