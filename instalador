    #region BLOCOS DE TAREFA (executam em background job)

    # Preambulo replicado dentro de cada job: resolve executaveis mesmo sem PATH atualizado.
    $jobPreamble = @'
        $ErrorActionPreference = 'Continue'
        try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }

        function Resolve-Exe([string]$name, [string[]]$fallbacks) {
            $cmd = Get-Command $name -ErrorAction SilentlyContinue
            if ($cmd) { return $cmd.Source }
            foreach ($f in $fallbacks) { if ($f -and (Test-Path $f)) { return $f } }
            return $null
        }
        function Get-Choco  { Resolve-Exe 'choco'  @("$env:ProgramData\chocolatey\bin\choco.exe") }
        function Get-Winget { Resolve-Exe 'winget' @() }

        function Show-WingetResult([int]$code, [string]$nome) {
            switch ($code) {
                0            { "OK: $nome instalado com sucesso." }
                -1978335189  { "OK: $nome ja instalado / nada a fazer." }
                -1978335212  { "ERRO: pacote de $nome nao encontrado no repositorio." }
                -1978335216  { "ERRO: $nome - contrato de origem nao aceito." }
                -1978334956  { "AVISO: $nome exige reinicializacao para concluir." }
                default      { "AVISO: $nome terminou com codigo $code." }
            }
        }
'@

    # ATENCAO: o bloco param() precisa ser a PRIMEIRA instrucao do scriptblock. Se vier depois do
    # preambulo, o PowerShell o interpreta como uma chamada de comando, o argumento nao e vinculado
    # e $app chega nulo dentro do job.
    $installAppScript = [scriptblock]::Create("param(`$app)`n" + $jobPreamble + @'

        Write-Output ("--- {0}  [{1}: {2}] ---" -f $app.Nome, $app.Src, $app.ID)

        if ($app.Src -eq 'choco') {
            $choco = Get-Choco
            if (-not $choco) { Write-Output "ERRO: Chocolatey nao encontrado."; return }
            & $choco install $app.ID -y --no-progress 2>&1 | ForEach-Object { Write-Output "  $_" }
            if ($LASTEXITCODE -eq 0)      { Write-Output "OK: $($app.Nome) instalado com sucesso via Chocolatey." }
            elseif ($LASTEXITCODE -eq 3010) { Write-Output "AVISO: $($app.Nome) instalado, reinicializacao pendente." }
            else                          { Write-Output "AVISO: $($app.Nome) terminou com codigo $LASTEXITCODE." }
            return
        }

        $winget = Get-Winget
        if (-not $winget) { Write-Output "ERRO: Winget nao encontrado nesta maquina."; return }

        $wingetArgs = @(
            'install', '--id', $app.ID, '--exact', '--silent',
            '--accept-package-agreements', '--accept-source-agreements', '--disable-interactivity'
        )
        if ($app.Src -eq 'msstore') { $wingetArgs += @('--source', 'msstore') }
        else                        { $wingetArgs += @('--source', 'winget')  }

        Write-Output ("COMANDO: winget {0}" -f ($wingetArgs -join ' '))
        & $winget @wingetArgs 2>&1 | ForEach-Object { Write-Output "  $_" }
        $code = $LASTEXITCODE
        Write-Output (Show-WingetResult $code $app.Nome)
        if ($code -ne 0 -and $app.Src -eq 'msstore') {
            Write-Output "  DICA: pacotes da Microsoft Store dependem da Store instalada e de uma conta Microsoft."
            Write-Output "  Em Windows LTSC, ou com a Store removida, este item nao instala por aqui."
        }
'@)

    $chocoBootstrapScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Instalando o Chocolatey ---"
        if (Get-Choco) { Write-Output "OK: Chocolatey ja esta instalado."; return }
        try {
            Set-ExecutionPolicy Bypass -Scope Process -Force
            [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor 3072
            Invoke-Expression ((New-Object Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')) 2>&1 |
                ForEach-Object { Write-Output "  $_" }
        } catch {
            Write-Output "ERRO: Falha ao instalar o Chocolatey. $($_.Exception.Message)"
            return
        }
        if (Get-Choco) { Write-Output "OK: Chocolatey instalado com sucesso." }
        else           { Write-Output "ERRO: A instalacao do Chocolatey nao pode ser confirmada." }
'@)

    $wingetBootstrapScript = [scriptblock]::Create($jobPreamble + @'

        Write-Output "--- Instalando o Winget (via Chocolatey) ---"
        if (Get-Winget) { Write-Output "OK: Winget ja esta instalado."; return }
        $choco = Get-Choco
        if (-not $choco) { Write-Output "ERRO: Chocolatey indisponivel, nao e possivel instalar o Winget."; return }
        # O pacote correto e 'winget-cli'. O antigo 'microsoft-winget' nao existe no repositorio,
