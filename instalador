            # largura uniforme e reduz a altura total da area de selecao.
            # (CheckBox nao expoe AutoSizeMode publicamente, ao contrario de Button; AutoSize
            #  sozinho ja encolhe e cresce conforme o texto.)
            $chip.AutoSize    = $true
            $chip.Padding     = New-Object Windows.Forms.Padding(10, 3, 10, 3)
            $chip.MinimumSize = New-Object Drawing.Size(0, 25)
            $chip.FlatAppearance.BorderSize          = 1
            $chip.FlatAppearance.BorderColor         = $Theme.ChipBorder
            $chip.FlatAppearance.CheckedBackColor    = $Theme.ChipOn
            $chip.FlatAppearance.MouseOverBackColor  = $Theme.ChipHover
            $tip.SetToolTip($chip, "$($app.Nome)`n$($app.ID)  [$src]")

            # Apenas cor e borda mudam ao marcar. Alternar o peso da fonte redimensionaria o chip
            # (ele e AutoSize) e faria a categoria inteira refluir a cada clique.
            $chip.Add_CheckedChanged({
                if ($this.Checked) { $this.FlatAppearance.BorderColor = $Theme.ChipOnBrd }
                else               { $this.FlatAppearance.BorderColor = $Theme.ChipBorder }
                Update-SelectionCount
            })

            $flow.Controls.Add($chip)
            $chips += $chip
            $script:AllChips += $chip
        }

        $groupBox.Controls.Add($flow)
        $appsPanel.Controls.Add($groupBox)

        $script:CatList += [pscustomobject]@{ Name = $catName; Group = $groupBox; Flow = $flow; Chips = $chips }
